{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.retro-spare.fr/fiso/schemas/fiso-meta-1.schema.json",
  "title": "FISO META chunk, schema fiso.meta/1",
  "type": "object",
  "required": ["schema", "album", "disc", "tracks"],
  "properties": {
    "schema": { "const": "fiso.meta/1" },
    "album": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        "genre": { "type": "string" },
        "label": { "type": "string" },
        "catalog_number": { "type": "string" },
        "country": { "type": "string" },
        "barcode": { "type": "string" },
        "group_id": { "type": "string" },
        "musicbrainz": {
          "type": "object",
          "properties": {
            "release_id": { "type": "string" },
            "release_group_id": { "type": "string" },
            "album_artist_id": { "type": "string" },
            "disc_id": { "type": "string" }
          }
        }
      }
    },
    "disc": {
      "type": "object",
      "required": ["number", "total"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 999 },
        "total": { "type": "integer", "minimum": 1, "maximum": 999 },
        "subtitle": { "type": "string" }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 99 },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "musicbrainz": {
            "type": "object",
            "properties": {
              "recording_id": { "type": "string" },
              "track_id": { "type": "string" }
            }
          }
        }
      }
    },
    "cdtext": { "type": "object" },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "source": { "enum": ["cd", "files", "cue"] },
        "creator": { "type": "string" },
        "derived_from": { "type": "string" },
        "cd_mastering": {
          "type": "object",
          "properties": {
            "alignment": { "enum": ["shift"] },
            "moved_boundaries": { "type": "integer", "minimum": 0 },
            "max_shift_ms": { "type": "number", "minimum": 0 },
            "end_padding_samples": { "type": "integer", "minimum": 0 },
            "converted_from": { "type": "string" }
          }
        },
        "created": { "type": "string" },
        "rip": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["secure", "fast"] },
            "drive": { "type": "string" },
            "read_offset": { "type": "integer" },
            "unrecovered_errors": { "type": "integer", "minimum": 0 },
            "verified": { "type": "boolean" },
            "verification": { "type": "string" }
          }
        }
      }
    }
  }
}
